{
  "env": {
    "browser": true,
    "es2021": true,
    "webextensions": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "linebreak-style": ["error", "unix"],
    "semi": ["error", "always"],
    "no-unused-vars": "error",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["background.js"],
      "globals": {
        "importScripts": "readonly",
        "ZhiyiTranslators": "readonly"
      }
    },
    {
      "files": ["content.js"],
      "globals": {
        "WordwiseSiteRules": "readonly",
        "zhiyiThresholdForLevel": "readonly",
        "createWordDifficultyScorer": "readonly"
      }
    },
    {
      "files": ["options.js"],
      "globals": {
        "WordwiseSiteRules": "readonly"
      }
    },
    {
      "files": ["lib/translators.js"],
      "globals": {
        "Translator": "readonly"
      }
    },
    {
      "files": ["tests/**/*.js", "tools/**/*.js"],
      "env": {
        "browser": false,
        "webextensions": false,
        "node": true
      }
    }
  ]
}
